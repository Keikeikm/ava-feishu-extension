# 飞书企业自建应用，启用机器人能力和长连接事件订阅
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 群聊文字消息仅响应 @ 此机器人的消息；填写机器人的 open_id（ou_ 开头）
# 私聊使用无需填写；群聊文件在开通群消息权限后直接接收
FEISHU_BOT_OPEN_ID=

# 支持 Chat Completions 的模型服务，填写供应商的模型名和 API 地址
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com

# 可选：逗号分隔的用户 open_id；留空允许应用可见范围内的用户
ALLOWED_USER_IDS=
DATA_DIR=./data
MAX_FILE_MB=20
MAX_SESSIONS=8
SESSION_TTL_MINUTES=60
JOB_TIMEOUT_SECONDS=180
MAX_RESULT_ROWS=500
# 在分析结论卡内显示图表；同时允许用 /导出 图表 按需生成 HTML
ENABLE_CHARTS=true
# 终端是否显示收到的用户文本，生产环境可设为 false
LOG_USER_INPUT=true
# 可选：训练用 Python 路径，默认优先使用项目内 .venv/bin/python
# ML_PYTHON=.venv/bin/python
