{
  "name": "@ava/base-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm --prefix plugin start\"",
    "build": "tsc --noEmit && npm run build:plugin && npm run build:preview",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:preview": "concurrently -k \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "plugin:configure": "node scripts/plugin-config.mjs",
    "build:plugin": "npm --prefix plugin run build",
    "build:preview": "vite build",
    "plugin:upload": "npm --prefix plugin run upload",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ava/analysis-core": "0.1.0",
    "@ai-sdk/openai": "^4.0.108",
    "@antv/ava": "4.0.0",
    "@lark-opdev/block-bitable-api": "^0.4.1-alpha.11",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lark-opdev/block-bitable-webpack-utils": "^0.1.7",
    "@lark-opdev/cli": "^3.4.4",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "prettier": "^3.9.10",
    "style-loader": "^4.0.0",
    "supertest": "^7.1.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^5.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.7"
  }
}
