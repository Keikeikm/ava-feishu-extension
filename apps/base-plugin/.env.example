# Node.js >=22.13. Copy this file to .env and fill in AVA_API_KEY and AVA_MODEL.
# Preferred API port; npm run dev automatically finds the next free port if occupied.
PORT=3001
HOST=127.0.0.1
AVA_API_KEY=
AVA_MODEL=
# Optional OpenAI-compatible Chat Completions endpoint, including /v1 if needed.
AVA_BASE_URL=
# Production service token. Local npm run dev manages authentication automatically.
PLUGIN_ACCESS_TOKEN=
# npm run dev adds its selected local debug origins automatically.
# Production: replace/add the actual plugin frame origin.
PLUGIN_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
