# Node.js >=22.13. Copy this file to .env. Leave model values empty for demo mode.
PORT=3001
HOST=127.0.0.1
AVA_API_KEY=
AVA_MODEL=
# Optional OpenAI-compatible Chat Completions endpoint, including /v1 if needed.
AVA_BASE_URL=
# Optional shared access token. Required when HOST=0.0.0.0; enter in plugin settings.
PLUGIN_ACCESS_TOKEN=
# Official opdev debug origin(s); production: replace/add the actual plugin frame origin.
PLUGIN_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
